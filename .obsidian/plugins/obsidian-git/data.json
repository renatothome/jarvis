{
  "commitMessage": "vault: {{date}}",
  "autoCommitMessage": "auto: {{date}}",
  "commitDateFormat": "YYYY-MM-DD HH:mm",
  "autoSaveInterval": 10,
  "autoPushInterval": 0,
  "autoPullInterval": 30,
  "autoPullOnBoot": true,
  "autoBackupAfterFileChange": false,
  "disablePush": false,
  "pullBeforePush": true,
  "syncMethod": "merge",
  "disablePopups": false,
  "disablePopupsForNoChanges": true,
  "showStatusBar": true
}
